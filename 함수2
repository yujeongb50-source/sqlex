select * from emp;
SELECT SYSDATE,
TO_CHAR(SYSDATE, 'HH24:MI:SS') AS 
HH24MISS,
TO_CHAR(SYSDATE, 'HH12:MI:SS AM') AS 
HHMISS_AM,
TO_CHAR(SYSDATE, 'HH:MI:SS P.M.') AS 
HHMISS_PM
FROM DUAL;


