--<<<<함수>>>>
select * from emp where upper(ename) = upper('scott');
select * from emp where upper(ename) like upper('%scott


-- 문자열 일부 추출( ex) job,1,2 첫번째 부터 두개 문자 )
select * from emp;
select job,substr(job,1,2),substr(job,3,2),substr(job,5)from emp


-- 문자열 길이
select * from emp;
select ename, length(ename) from emp;

select * from emp;
select ename, length(ename) from emp where length(ename) >=5



-- 문자열 데이터 내 특벙 문자 위치 찾기
select * from emp;
select * from emp where instr(ename,'S') >0 


-- 특정 문자를 다른 문자로 대체
select * from emp; 
select '010-1234-5678' as replace_before, 
replace('010-1234-5678','-',' ')as replace_1,
replace('010-1234-5678','-')as replace_2 from dual;


-- 데이터의 빈 공간 채우기
select * from emp;
select 'Oracle',lpad('Oracle', 10, '#') as lpad_1, rpad('Oracle',10,'*') as rpad_1,
lpad('Oracle',10)as lpad_2, rpad('Oracle',10)as rpad_2 from dual;


-- 두 문자열 데이터를 합치기
select * from emp;
select concat(empno, ename), concat(empno, concat(':', ename)) from emp where ename = 'SCOTT';

select * from emp;
select concat(empno, ename) from emp where ename = 'SCOTT';


-- 반올림
select * from emp;
select round(1234.5678) as round, 
round(1234.5678, 0) as round_0,
round(1234.5678, 1) as round_1,
round(1234.5678, 2) as round_2,
round(1234.5678, -1) as round_yujeong1,
round(1234.5678, 02) as round_yujeong2 from dual;


-- 버림
select * from emp;
select trunc(1234.5678) as trunc,
trunc(1234.5678,0) as trunc_0,
trunc(1234.5678, 1) as trunc_1,
trunc(1234.5678, 2) as trunc_2,
trunc(1234.5678, -1) as trunc_yujeong1,
trunc(1234.5678, -2) as trunc_yujeong2 from dual;

-- ceil 지정된 숫자와 가장 가까운 큰 정수 / floor 지정된 숫자와 가장 가까운 작은 정수
select * from emp;
select ceil(3.14), 
floor(3.14),
ceil(-3.14),
floor(-3.14) from dual;

-- 숫자를 나눈 나머지
select * from emp;
select mod(15, 6),
mod(10,2),
mod(11,2) from dual;
