코드
=> 테이블 생성
create table SHOP_PRODUCT(
PROD_ID numbeR(4) primary key,
PROD_NAME varchar2(50) not null,
CATEGORY varchar2(20) null,
PRICE NUMBER(10) CHECK(PRICE > 0),
STOK NUMBER(5) NULL,
REG_DATE DATE DEFAULT SYSDATE);

=> SQL문 작성
1번 문항
SELECT * FROM SHOP_PRODUCT  
ORDER BY PRICE DESC;

2번 문항
SELECT CATEGORY,AVG(PRICE)

FROM SHOP_PRODUCT
GROUP BY PRICE, CATEGORY
HAVING AVG(PRICE) >= 500000
ORDER BY PRICE, CATEGORY;

3번 문항
SELECT PRICE, PROD_NAME FROM SHOP_PRODUCT WHERE PRICE > (SELECT AVG(PRICE)
FROM SHOP_PRODUCT);

5번 문항
SELECT * FROM SHOP_PRODUCT
WHERE PROD_NAME LIKE '%S' 
OR category = '생활';

